# Required (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=todo
DB_USER=todo
DB_PASSWORD=todo
DB_POOL_SIZE=10
PORT=8080
JWT_ISSUER=todo-api
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
MIGRATIONS_DIR=./migrations

# Comma-separated, no spaces. "*" allows any origin. Empty disables CORS.
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=10

# true when behind a trusted proxy/LB (uses X-Forwarded-For)
TRUST_PROXY=false
